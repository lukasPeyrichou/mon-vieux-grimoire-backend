# Copier ce fichier en .env et adapter les valeurs
PORT=4000
# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/mon-vieux-grimoire?retryWrites=true&w=majority
# Clé secrète qui signe les tokens JWT (longue chaîne aléatoire, à garder privée)
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
