# Copier ce fichier en .env et adapter les valeurs
PORT=4000
# Connexion Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/mon-vieux-grimoire?retryWrites=true&w=majority
# Clé secrète des tokens JWT, à générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
